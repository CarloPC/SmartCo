rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
		
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin', 'barangay_official'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Includes BHWs, Admins, and Barangay Officials
    function isBHW() {
      return isAuthenticated() && getUserRole() in ['bhw', 'admin', 'barangay_official'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);

      allow update: if isAuthenticated() && isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow update: if isAdmin() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow update: if isSuperAdmin();

      allow list: if isAdmin() || (isAuthenticated() && resource.data.role in ['bhw', 'admin', 'barangay_official']);
    }

    // ─── Health Records (Vitals, Clinical Logs) ──────────────────────────────
    // ─── Purok Stats (privacy-safe aggregate counters, no individual data) ──
    // Only non-sensitive counts (total/pending/approved/rejected/monthly) are
    // ever written here — never names, vitals, or record-level detail — so
    // it's safe for every authenticated resident to read.
    // NOTE: writes are intentionally open to any authenticated user because
    // this project has no backend/Cloud Functions to validate increments
    // server-side. Worst case of a bad write is an inaccurate counter, not a
    // data leak, since no PII is ever stored in this collection. If a
    // backend is added later, lock this down to Admin SDK / Cloud Functions
    // only.
    match /purokStats/{purokId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Health Records (Vitals, Clinical Logs) ──────────────────────────────
    match /healthRecords/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isBHW() // ✅ FIXED: BHW can now read health records
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isBHW(); // ✅ FIXED: BHW can now update/log health records
      allow delete: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.approvalStatus == 'pending') ||
        isAdmin()
      );
    }

    // ─── Health Requests (Groq AI Summaries & Scheduling) ───────────────────
    match /health_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isBHW()
      );
      // ✅ FIXED: residents need list access to see booked slots when
      // scheduling a checkup (ScheduleCheckupModal queries this collection).
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isBHW();
      allow delete: if isSuperAdmin();
    }

    // ─── Food Aid ────────────────────────────────────────────────────────────
    match /foodAid/{scheduleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.approvalStatus == 'pending') ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.approvalStatus == 'pending') ||
        isAdmin()
      );
    }

    // ─── Events ──────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.approvalStatus == 'pending') ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.approvalStatus == 'pending') ||
        isAdmin()
      );
    }

    // ─── Announcements (Community Board) ─────────────────────────────────────
    match /announcements/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid || isAdmin()
        );
      }
    }

    // ─── Emergencies ─────────────────────────────────────────────────────────
    // ✅ UPDATED (Emergency Reporting Enhancement): a report must now include
    // either a proof photo (proofProvided == true, with a non-empty
    // proofImageUrl) OR an acknowledged Emergency Override
    // (emergencyOverride == true). This mirrors the client-side validation in
    // ReportEmergencyPage/emergencyService so a bypassed/forged client can't
    // create an "Invalid Report" (no proof, no override) directly against
    // Firestore. Both fields are still required to be present and boolean —
    // legacy documents created before this change won't have them, which is
    // fine since this rule only runs on new writes.
    function hasValidProof() {
      return request.resource.data.emergencyOverride is bool &&
        request.resource.data.proofProvided is bool &&
        (
          (request.resource.data.proofProvided == true &&
           request.resource.data.proofImageUrl is string &&
           request.resource.data.proofImageUrl != '') ||
          request.resource.data.emergencyOverride == true
        );
    }

    match /emergencies/{emergencyId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        hasValidProof();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Role Upgrade Requests (formerly "Admin Access Requests") ───────────
    // Reuses the adminRequests collection. Note: `allow update` here is
    // isSuperAdmin() rather than isAdmin(), even though AdminRoute also lets
    // barangay_official/bhw reach the review page in the UI. This is
    // intentional — only isSuperAdmin() can write users/{uid}.role above, so
    // letting a barangay_official mark a request "approved" here would leave
    // it stuck in a false "approved" state with the user's role unchanged.
    match /adminRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedRole in ['barangay_official', 'bhw'] &&
        request.resource.data.proofFileUrl is string &&
        request.resource.data.proofFileUrl != '';

      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();

      allow update: if isSuperAdmin() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.requestedRole == resource.data.requestedRole;

      allow delete: if isSuperAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    // ─── Document Requests ────────────────────────────────────────────────
match /documentRequests/{requestId} {

  allow create: if isAuthenticated() &&
    request.resource.data.userId == request.auth.uid;

  allow read: if isAuthenticated() &&
    (
      resource.data.userId == request.auth.uid ||
      isAdmin()
    );

  // Only Barangay Officials/Admins process requests
  allow update: if isAdmin();

  // Resident owns the request and it's still pending: allow only the
  // harmless housekeeping fields the client writes right after creating
  // it (requestId, notificationSent, updatedAt). Status/approval fields
  // stay locked to isAdmin() above.
  allow update: if isAuthenticated() &&
    resource.data.userId == request.auth.uid &&
    resource.data.status == 'pending' &&
    request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['requestId', 'notificationSent', 'updatedAt']);

  allow delete: if false;
}
  }
}
